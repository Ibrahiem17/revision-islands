# Copy to .env.local (git-ignored) for local dev; set the same names in Vercel for production.
# Cloud sync is OFF unless VITE_CLOUD_SYNC=true AND the two VITE_* values are set.

# Server-side (api/*.js) - never exposed to the browser
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Client-side (baked into the bundle at build time; the anon key is public by design)
VITE_CLOUD_SYNC=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
